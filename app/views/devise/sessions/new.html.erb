<% content_for :hide_navbar, true %>

<div class="signup-container">

  <div class="logo-container">
    <%= image_tag "logo.PNG", alt: "logo des blouses roses", class: "logo" %>
  </div>

<h2>Connexion</h2>

<%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="form-inputs">
    <%= f.input :email,
                label: "Email",
                required: false,
                autofocus: true,
                input_html: { autocomplete: "email" } %>
    <%= f.input :password,
                label: "Mot de passe",
                required: false,
                input_html: { autocomplete: "current-password" } %>
    <%= f.input :remember_me, as: :boolean, label: "Se souvenir de moi" if devise_mapping.rememberable? %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "Se connecter", class: "signup-btn" %>
  </div>
<% end %>

  <div class="login-link">
    <%= link_to "Pas encore de compte ? Créer un compte", new_user_registration_path %>
  </div>

  <div class="forgot-password">
  <%= link_to "Mot de passe oublié ?", new_password_path(resource_name) %>
  </div>
</div>
