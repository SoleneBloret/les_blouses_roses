<%#
  NAVBAR / HEADER CARD
  - Utilisateur connecté : avatar à gauche (dropdown), titre de page centré, bouton menu hamburger à droite.
  - Utilisateur non connecté : barre blanche simple avec un lien "Se connecter".
  - Les styles associés sont dans app/assets/stylesheets/components/_navbar.scss (.header-card, etc.)
  - Pour ajouter un nouveau titre de page, compléter le hash `page_label` ci-dessous.
%>
<% if user_signed_in? %>
  <%
    page_label = {
      "pages"         => { "home" => "Accueil", "menu" => "Mon espace" },
      "profiles"      => { "index" => "Annuaire", "show" => (@profile&.user == current_user ? "Mon profil" : "Contact"), "edit" => "Modifier mon profil", "new" => "Créer mon profil" },
      "participations"      => { "index" => "Agenda", "available" => "Permanences disponibles", "replacement" => "Remplacement", "map" => "Map", "show" => "Agenda" },
      "unavailabilities"    => { "index" => "Absence", "new" => "Absence", "create" => "Absence" },
      "reports"             => { "new" => "Compte-rendu", "create" => "Compte-rendu" }
    }.dig(controller_name, action_name) || "Les Blouses Roses"
    on_my_profile = controller_name == "profiles" && action_name == "show" && @profile&.user == current_user
  %>

  <div class="header-card
    <%= 'header-card--orange' if controller_name == 'unavailabilities' %>
    <%= 'header-card--orange' if controller_name == 'participations' && action_name == 'available' %>
    <%= 'header-card--orange' if controller_name == 'participations' && action_name == 'replacement' %>
">

    <%= link_to current_user.profile ? profile_path(current_user.profile) : new_profile_path, class: "header-avatar-btn" do %>
      <% if current_user.profile&.photo&.attached? %>
        <%= image_tag current_user.profile.photo, alt: "" %>
      <% elsif current_user.profile %>
        <%= "#{current_user.profile.first_name[0]}#{current_user.profile.last_name[0]}".upcase %>
      <% else %>
        <i class="fa-solid fa-user"></i>
      <% end %>
    <% end %>

    <h1 class="header-page-label"><%= page_label %></h1>

    <% if on_my_profile %>
      <%= link_to menu_path, class: "header-menu-btn", aria: { label: "Ouvrir le menu" } do %>
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      <% end %>
    <% else %>
      <div class="header-dropdown-wrapper" data-controller="dropdown">
        <button class="header-menu-btn" data-action="click->dropdown#toggle" aria-label="Ouvrir le menu">
          <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
        <div class="header-dropdown-menu" data-dropdown-target="menu">
          <%= link_to current_user.profile ? profile_path(current_user.profile) : new_profile_path, class: "header-dropdown-item" do %>
            <i class="fa-solid fa-circle-user me-2" aria-hidden="true"></i>Mon espace
          <% end %>
          <%= button_to destroy_user_session_path, method: :delete, class: "header-dropdown-item header-dropdown-item--logout", form: { "data-turbo": false } do %>
            <i class="fa-solid fa-right-from-bracket me-2" aria-hidden="true"></i>Se déconnecter
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

<% else %>
  <nav class="navbar navbar-expand-sm navbar-light navbar-lewagon">
    <div class="container-fluid justify-content-end">
      <%= link_to "Se connecter", new_user_session_path, class: "nav-link" %>
    </div>
  </nav>
<% end %>
