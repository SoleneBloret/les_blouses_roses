<div class="menu-page">

  <div class="menu-page__content">

    <%# MON COMPTE %>
    <p class="menu-section__title">MON COMPTE</p>
    <div class="menu-section">
      <% if current_user.profile %>
        <%= link_to profile_path(current_user.profile), class: "menu-card" do %>
          <div class="menu-card__icon-wrap"><i class="fa-solid fa-user" aria-hidden="true"></i></div>
          <div class="menu-card__body">
            <span class="menu-card__label">Mon profil</span>
          </div>
          <i class="fa-solid fa-chevron-right menu-card__arrow" aria-hidden="true"></i>
        <% end %>
      <% end %>

      <div class="menu-card menu-card--disabled">
        <div class="menu-card__icon-wrap"><i class="fa-solid fa-bell" aria-hidden="true"></i></div>
        <div class="menu-card__body">
          <span class="menu-card__label">Mes notifications</span>
        </div>
        <i class="fa-solid fa-chevron-right menu-card__arrow" aria-hidden="true"></i>
      </div>
    </div>

    <%# DÉCOUVRIR %>
    <p class="menu-section__title">DÉCOUVRIR</p>
    <div class="menu-section">
      <a href="https://www.lesblousesroses.asso.fr/fr/" target="_blank" rel="noopener noreferrer" class="menu-card">
        <div class="menu-card__icon-wrap"><i class="fa-solid fa-circle-info" aria-hidden="true"></i></div>
        <div class="menu-card__body">
          <span class="menu-card__label">Informations</span>
        </div>
        <i class="fa-solid fa-chevron-right menu-card__arrow" aria-hidden="true"></i>
      </a>

      <a href="https://www.lesblousesroses.asso.fr/fr/l-association" target="_blank" rel="noopener noreferrer" class="menu-card">
        <div class="menu-card__icon-wrap"><i class="fa-solid fa-heart" aria-hidden="true"></i></div>
        <div class="menu-card__body">
          <span class="menu-card__label">L'association</span>
        </div>
        <i class="fa-solid fa-chevron-right menu-card__arrow" aria-hidden="true"></i>
      </a>
    </div>

    <%# COMMUNAUTÉ %>
    <p class="menu-section__title">COMMUNAUTÉ</p>
    <div class="menu-section">
      <%= link_to profiles_path, class: "menu-card" do %>
        <div class="menu-card__icon-wrap"><i class="fa-solid fa-user-group" aria-hidden="true"></i></div>
        <div class="menu-card__body">
          <span class="menu-card__label">Annuaire des bénévoles</span>
        </div>
        <i class="fa-solid fa-chevron-right menu-card__arrow" aria-hidden="true"></i>
      <% end %>
    </div>

    <%# SE FORMER %>
    <p class="menu-section__title">SE FORMER</p>
    <div class="menu-section">
      <div class="menu-card menu-card--quiz">
        <div class="menu-card__icon-wrap menu-card__icon-wrap--gold"><i class="fa-solid fa-trophy" aria-hidden="true"></i></div>
        <div class="menu-card__body">
          <span class="menu-card__label">Quiz bénévole en or</span>
          <span class="menu-card__sublabel">Testez vos connaissances</span>
          <div class="menu-card__progress">
            <div class="menu-card__progress-bar" style="width: 70%"></div>
            <span class="menu-card__progress-label">7/10</span>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right menu-card__arrow" aria-hidden="true"></i>
      </div>
    </div>

    <%# Se déconnecter %>
    <%= button_to destroy_user_session_path, method: :delete, class: "menu-signout" do %>
      Se déconnecter
    <% end %>

  </div>
</div>
