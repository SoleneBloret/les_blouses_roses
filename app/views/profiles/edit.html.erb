<div class="profile-container container-sm">

  <!-- TITRE -->
  <h2>Modifier mon profil</h2>


  <!-- FORMULAIRE -->
  <%= simple_form_for(@profile) do |f| %>
    <%= f.input :first_name, required: true, label: "Prénom" %>
    <%= f.input :last_name, required: true, label: "Nom" %>
    <%= f.input :phone_number, required: true, label: "Téléphone portable" %>
    <%= f.input :address, required: true, label: "Adresse" %>
    <%= f.input :role,
        collection: ["🎓 En formation", "🎀 Bénévole confirmé", "🏥 Bénévole référent", "🔐 Administrateur"], label: "Mon statut de bénévole" %>
    <%= f.submit "Enregistrer", class: "btn btn-primary" %>
  <% end %>

</div>
