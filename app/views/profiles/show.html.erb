<div class="profile-container container-sm">

    <!-- PHOTO DE PROFIL -->
  <div class="profile-picture-section">
    <% if @profile.photo.attached? %>
      <%= image_tag @profile.photo, class: "profile-photo", alt: "Photo de profil de #{@profile.first_name} #{@profile.last_name}" %>
    <% else %>
      <div class="profile-photo-initials">
        <%= "#{@profile.first_name[0]}#{@profile.last_name[0]}".upcase %>
      </div>
    <% end %>
  </div>

  <%# BOUTON RETOUR SUPPRIMÉ : LA NAVIGATION SE FAIT VIA LE HEADER %>
  <%#= link_to "Retour", root_path, class: "btn btn-secondary" %>

  <!-- TITRE -->
  <%# TITRE SUPPRIMÉ : LE NOM DE LA PAGE EST DÉJÀ AFFICHÉ DANS LE HEADER %>


  <!-- FORMULAIRE -->
  <ul class="list-group">
    <li class="list-group-item"><strong>Prénom :</strong> <%= @profile.first_name %></li>
    <li class="list-group-item"><strong>Nom :</strong> <%= @profile.last_name %></li>
    <li class="list-group-item"><strong>Téléphone :</strong> <%= @profile.phone_number %></li>
    <li class="list-group-item"><strong>Adresse :</strong> <%= @profile.address %></li>
    <li class="list-group-item"><strong>Statut :</strong> <%= @profile.role %></li>
  </ul>

  <% if current_user.profile == @profile %>
    <%= link_to "Modifier", edit_profile_path(@profile), class: "btn btn-primary" %>
    <%= button_to "Se déconnecter", destroy_user_session_path, method: :delete, class: "btn btn-logout" %>
  <% end %>
</div>
