<div class="profile-container container-sm">

  <%# TITRE SUPPRIMÉ : LE NOM DE LA PAGE EST DÉJÀ AFFICHÉ DANS LE HEADER %>

  <!-- FORMULAIRE DE CRÉATION DU PROFIL -->
  <%= simple_form_for(@profile, html: { multipart: true }) do |f| %>

    <!--PHOTO DE PROFIL (AFFICHAGE + UPLOAD)-->
    <div class="profile-picture-section">

      <!-- IMAGE PAR DÉFAUT -->
      <%= image_tag "photopro.jpeg",
          class: "profile-photo",
          alt: "Photo de profil par défaut" %>

      <!-- BOUTON POUR AJOUTER UNE PHOTO -->
      <label for="photo-input" class="change-photo-btn">
        Ajouter une photo
      </label>

      <!-- INPUT FICHIER MASQUÉ -->
      <%= f.file_field :photo,
          class: "hidden-file-input",
          id: "photo-input" %>

    </div>

    <!-- INFOS UTILISATEUR -->
    <%= f.input :first_name, label: "Prénom" %>

    <%= f.input :last_name, label: "Nom" %>

    <%= f.input :phone_number, label: "Téléphone portable" %>

    <%= f.input :address, label: "Adresse" %>

    <%= f.input :role,
        label: "Mon statut de bénévole",
        collection: [
          "🎓 En formation",
          "👚 Bénévole confirmé",
          "🩷 Bénévole référent",
          "🔐 Administrateur"
        ] %>

    <!--BOUTON VALIDATION -->
    <%= f.submit "Créer mon profil", class: "btn btn-primary" %>

  <% end %>

</div>
