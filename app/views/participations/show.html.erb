<div class="page-layout">

  <div class="participation-show-card">
    <h2 class="participation-location"><%= @participation.permanence.location.name %></h2>

    <div class="participation-section">
      <p class="participation-label">Date :</p>
      <p class="participation-value"><%= @participation.permanence.week_day %> <%= @participation.date.strftime("%d") %></p>
      <p class="participation-value"><%= @participation.permanence.start_time %>h00 – <%= @participation.permanence.end_time %>h00</p>
    </div>

    <div class="participation-section">
      <p class="participation-label">Binôme :</p>
      <%# ⚠️ TODO : relier avec le binôme %>
      <span> ⚠️ A FAIRE </span>
    </div>

    <div class="participation-section">
      <p class="participation-label">Adresse :</p>
      <p class="participation-value"><%= @participation.permanence.location.address %></p>
    </div>

    <%= link_to "Voir sur la carte", "#", class: "btn-rose-centre" %>
    <%= link_to "J'ai une indisponibilité", "#", class: "btn-orange-centre" %>
  </div>

</div>
