<%= content_for :head do %>
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.7.0/mapbox-gl.css" rel="stylesheet">
<% end %>

<div class="page-layout">

  <div class="participation-show-card-rose">
    <h2 class="participation-location"><%= @participation.permanence.location.name %></h2>

    <div class="participation-section-rose">
      <p class="participation-label-rose">Date</p>
      <p class="participation-value-rose"><%= @participation.permanence.week_day %> <%= @participation.date.strftime("%d") %></p>
      <p class="participation-value-rose"><%= @participation.permanence.start_time %>h00 – <%= @participation.permanence.end_time %>h00</p>
    </div>

    <div class="participation-section-rose">
      <p class="participation-label-rose">Binôme</p>
      <% binome = @participation.binome %>
      <p class="participation-value-rose">
        <%= binome ? "#{binome.first_name} #{binome.last_name}" : "🔎 Nous recherchons un/une remplaçant(e)" %>
      </p>
    </div>

    <div class="participation-section-rose">
      <p class="participation-label-rose">Adresse</p>
      <p class="participation-value-rose"><%= @participation.permanence.location.address %></p>
    </div>

    <%= link_to "Voir sur la carte", map_participation_path(@participation), class: "btn-rose-centre" %>
    <%= link_to "J'ai une indisponibilité", new_unavailability_path, class: "btn-orange-centre" %>
  </div>

</div>
