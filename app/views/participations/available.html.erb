<div class="page-layout">

  <%= turbo_frame_tag "tab-content" do %>

    <!-- MENU TABS -->
    <div class="unavailability-toggle">
      <div class="nav nav-pills nav-fill participations-tabs">
        <!-- TAB 1 : inactif -->
        <div class="nav-item">
          <%= link_to "Mes permanences", participations_path,
              class: "nav-link rounded-pill",
              data: { turbo_frame: "_top" } %>
              <!-- Permet l'affichage différent du header entre rose et orange selon page -->
        </div>
        <!-- TAB 2 : actif -->
        <div class="nav-item">
          <%= link_to "Remplacements", available_participations_path,
              class: "nav-link active rounded-pill tab-available",
              aria: { current: "page" },
              data: { turbo_frame: "_top" } %>
              <!-- Permet l'affichage différent du header entre rose et orange selon page -->
        </div>
      </div>
    </div>

    <% if @participations.empty? %>
        <p class="mauve-text-centered mt-5">Toutes les permanences sont assurées ! 🎉</p>
    <% else %>
    <% @participations.each do |participation| %>
      <%= link_to replacement_participation_path(participation),
          class: "participation-index-card-orange row",
          data: { turbo_frame: "_top", calendar_target: "card", participation_date: participation.date.iso8601 } do %>

        <!-- BADGE AVEC LA DATE-->
        <li class="date-badge-orange col-1">
          <span class="day-title-orange"><%= participation.date.strftime("%d") %></span>
          <span class="month-title-orange"><%= I18n.l(participation.date, format: "%b") %></span>
        </li>

        <!-- TITRE ET RESUME DE LA CARD-->
        <li class="card-content-orange col">
          <p class="card-title-orange"><%= participation.permanence.location.name %> – <%= participation.permanence.service %></p>
          <p class="card-subtitle-orange"><%= participation.permanence.week_day %> · <%= participation.permanence.start_time %>h00 – <%= participation.permanence.end_time %>h00</p>
        </li>
        <% end %>
      <% end %> <!-- END du EACH PARTICIPATION-->
    <% end %>
  <% end %>
</div>
