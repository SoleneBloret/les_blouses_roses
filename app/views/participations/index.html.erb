<div class="page-layout">

  <%= turbo_frame_tag "tab-content" do %>

    <!-- MENU TABS -->
    <div class="unavailability-toggle">
      <div class="nav nav-pills nav-fill participations-tabs">
        <!-- TAB 1 : actif -->
        <div class="nav-item">
          <%= link_to "Mes permanences", participations_path,
              class: "nav-link active rounded-pill",
              data: { turbo_frame: "_top" } %>
        </div>
        <!-- TAB 2 : inactif -->
        <div class="nav-item">
          <%= link_to "Remplacements", available_participations_path,
              class: "nav-link rounded-pill",
              data: { turbo_frame: "_top" } %>
              <!-- Permet l'affichage différent du header entre rose et orange selon page -->
        </div>
      </div>
    </div>


    <!-- CALENDRIER DES PERMANENCES -->
    <% unavailable_dates = @unavailabilities.flat_map { |u| (u.start_date..u.end_date).map(&:iso8601) }.uniq %>
    <div data-controller="calendar"
         data-calendar-dates-value="<%= @participations.map { |p| { id: p.id, date: p.date.iso8601, substitute: p.substitute } }.to_json %>"
         data-calendar-unavailabilities-value="<%= unavailable_dates.to_json %>">

      <div class="calendar-widget">
        <div class="calendar-header">
          <button class="calendar-nav-btn" data-action="click->calendar#prev">&#8249;</button>
          <span class="calendar-title" data-calendar-target="title"></span>
          <button class="calendar-nav-btn" data-action="click->calendar#next">&#8250;</button>
        </div>
        <div class="calendar-weekdays">
          <span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span>
        </div>
        <div class="calendar-grid" data-calendar-target="grid"></div>
      </div>

      <p data-calendar-target="sectionTitle" class="ps-2">
        <span class="section-label">Mes permanences</span>
        <span class="home-card-text__title">- 15 prochains jours</span>
      </p>


      <!-- CARDS DES PERMANENCES -->
      <% @participations.each do |participation| %>
        <% if participation.substitute == true %>
          <%= link_to participation_path(participation),
              class: "participation-index-card-orange row",
              data: { turbo_frame: "_top", calendar_target: "card", participation_date: participation.date.iso8601 } do %>

            <!-- BADGE AVEC LA DATE-->
            <div class="date-badge-orange col-1">
              <span class="day-title-orange"><%= participation.date.strftime("%d") %></span>
              <span class="month-title-orange"><%= I18n.l(participation.date, format: "%b") %></span>
            </div>

            <!-- TITRE ET RESUME DE LA CARD-->
            <div class="card-content-orange col">
              <p class="card-title-orange"><%= participation.permanence.location.name %> – <%= participation.permanence.service %></p>
              <p class="card-subtitle-orange"><%= participation.permanence.week_day %> · <%= participation.permanence.start_time %>h00 – <%= participation.permanence.end_time %>h00</p>
            </div>
          <% end %>

        <% else %>
          <%= link_to participation_path(participation),
              class: "participation-index-card-rose row",
              data: { turbo_frame: "_top", calendar_target: "card", participation_date: participation.date.iso8601 } do %>

            <!-- BADGE AVEC LA DATE-->
            <div class="date-badge-rose col-1">
              <span class="day-title-rose"><%= participation.date.strftime("%d") %></span>
              <span class="month-title-rose"><%= I18n.l(participation.date, format: "%b") %></span>
            </div>

            <!-- TITRE ET RESUME DE LA CARD-->
            <div class="card-content-rose col">
              <p class="card-title-rose"><%= participation.permanence.location.name %> – <%= participation.permanence.service %></p>
              <p class="card-subtitle-rose"><%= participation.permanence.week_day %> · <%= participation.permanence.start_time %>h00 – <%= participation.permanence.end_time %>h00</p>
            </div>
          <% end %>
        <!-- FIN DU IF -->
        <% end %>
      <!-- FIN DU EACH DO -->
      <% end %>

    <!-- FIN DIV CALENDAR -->
    </div>

  <!-- FIN DU TURBO -->
  <% end %>

<!-- FIN DE LA DIV -->
</div>
